# Stream Service Environment Variables
# Copy this file to .env and fill in your values

# ===================
# Inworld AI (Required)
# ===================
# Get your API key from https://studio.inworld.ai
INWORLD_API_KEY=your_inworld_api_key_here

# Voice ID for TTS (optional - uses default if not set)
# Create a cloned voice at https://studio.inworld.ai and copy the voice ID
INWORLD_VOICE_ID=your_voice_id_here

# ===================
# FAL AI - Video Sync (Required)
# ===================
# Get your API key from https://fal.ai
FAL_KEY=your_fal_api_key_here

# ===================
# OBS WebSocket (Required for streaming)
# ===================
OBS_WEBSOCKET_HOST=localhost
OBS_WEBSOCKET_PORT=4455
OBS_WEBSOCKET_PASSWORD=your_obs_websocket_password

# OBS Scene/Source Names
OBS_BASE_SCENE=Base Scene
OBS_GENERATED_SCENE=Generated Scene
OBS_GENERATED_SOURCE=Generated Video

# ===================
# File Paths
# ===================
BASE_VIDEO_PATH=./assets/base_video.mp4
OUTPUT_DIR=./generated_videos

# ===================
# Server Configuration
# ===================
PORT=3000
HOST=0.0.0.0
BASE_URL=http://localhost

# ===================
# Queue Configuration
# ===================
MIN_QUEUE_SIZE=3
MAX_QUEUE_SIZE=10
MAX_CONCURRENT=10
MIN_PRIORITY=3

# ===================
# Pump.fun Chat Integration (Optional)
# ===================
USE_PUMP_FUN=false
PUMP_FUN_URL=https://pump.fun/your-token-address
PUMP_FUN_HEADLESS=true
